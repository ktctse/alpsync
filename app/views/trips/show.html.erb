<% content_for :title, "#{@trip.name} · #{@trip.resort} · Alpsync" %>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
  <section>
    <%= render "trip", trip: @trip %>
    <% if @trip.note.present? %>
      <p class="mt-3 px-1 text-sm text-slate-600 italic">“<%= @trip.note %>”</p>
    <% end %>

    <% if @mine %>
      <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm">
        <p class="font-medium text-amber-900">Your private link</p>
        <p class="mt-1 text-amber-800">Save it to edit or delete your trip from any device. Anyone with this link can change your post.</p>
        <input readonly value="<%= manage_trip_url(@trip.edit_token) %>" aria-label="Private link"
               class="mt-2 w-full rounded-md border border-amber-300 bg-white px-2 py-1 text-xs text-slate-700" onclick="this.select()">
        <%= link_to "Edit trip", manage_trip_path(@trip.edit_token), class: "mt-2 inline-block font-medium text-amber-900 underline" %>
      </div>
    <% end %>
  </section>

  <section>
    <% if @mine %>
      <h2 class="text-lg font-semibold text-slate-900">Your matches</h2>
      <p class="mb-4 text-sm text-slate-500">
        Riders in <%= @trip.region %> on overlapping dates who share a language, ranked by how well you fit.
      </p>
      <% if @matches.any? %>
        <div class="flex flex-col gap-3"><%= render partial: "match", collection: @matches %></div>
      <% else %>
        <div class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-slate-600">
          No matches yet. New trips are matched as they're posted, so check back, or add more tags to widen your search.
        </div>
      <% end %>
    <% else %>
      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-900">Riding around the same dates?</h2>
        <p class="mt-1 text-slate-600">
          Post your trip to see whether you match with <%= @trip.name %> and to unlock contact details.
        </p>
        <%= link_to "Post a trip", new_trip_path(resort: @trip.resort),
                    class: "mt-4 inline-block rounded-lg bg-slate-900 px-4 py-2 text-sm text-white hover:bg-slate-700" %>
      </div>
    <% end %>
  </section>
</div>
