<% content_for :title, "Post a trip · Alpsync" %>

<div class="mx-auto max-w-2xl">
  <h1 class="mb-1 text-2xl font-semibold text-slate-900">Post your trip</h1>
  <p class="mb-6 text-slate-600">No account needed. You'll get a private link to edit or delete it later.</p>

  <% if TripDraft.available? %>
    <%# Paste-to-post: Claude reads the message and refills the form below (TripsController#draft) %>
    <section class="mb-6 rounded-xl border border-sky-200 bg-sky-50/60 p-4 sm:p-6">
      <h2 class="font-semibold text-slate-900">Already posted it in a group chat?</h2>
      <p class="mt-1 text-sm text-slate-600">
        Paste your WhatsApp, WeChat or LINE message and Claude fills in the form for you to check.
        Your message is sent to Claude to read and isn't saved.
      </p>
      <%= form_with url: draft_trips_path, class: "mt-3 space-y-3" do |f| %>
        <%= f.text_area :message, rows: 4, required: true, maxlength: TripDraft::MAX_MESSAGE_LENGTH, class: field_class,
                        "aria-label": "Your group-chat message",
                        placeholder: "Anyone heading to Hakuba Jan 10-14? I'm driving up from Nagano and need someone to split a lodge. English or Cantonese, WhatsApp me on +852 …" %>
        <div class="flex flex-wrap items-center gap-3">
          <%= f.submit "Fill in the form", data: { turbo_submits_with: "Reading your message…" },
                       class: "cursor-pointer rounded-lg bg-sky-600 px-4 py-2 text-sm font-medium text-white hover:bg-sky-700" %>
          <p id="draft_status" class="text-sm text-slate-600" aria-live="polite"></p>
        </div>
      <% end %>
    </section>
  <% end %>

  <div id="trip_form"><%= render "form", trip: @trip %></div>
</div>
