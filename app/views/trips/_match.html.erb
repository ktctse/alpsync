<article class="rounded-xl border border-slate-200 bg-white p-4">
  <div class="flex items-center justify-between gap-2">
    <div class="flex min-w-0 items-center gap-3">
    <%= avatar_tag(match.trip, size: "h-10 w-10") %>
    <h3 class="font-semibold text-slate-900">
      <%= link_to match.trip.name, match.trip, class: "hover:underline" %>
      <span class="text-sm font-normal text-slate-500">· <%= match.trip.skill_level %> · <%= resort_list(match.trip) %></span>
      <% if match.trip.demo? %><span class="ml-1 rounded bg-slate-100 px-1.5 py-0.5 align-middle text-[11px] font-normal text-slate-500">Sample</span><% end %>
    </h3>
    </div>
    <% if match.mutual %>
      <span class="shrink-0 rounded-md border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-xs text-emerald-800">Mutual match</span>
    <% end %>
  </div>
  <p class="mt-0.5 text-sm text-slate-600"><%= trip_dates(match.trip) %> · <%= match.trip.languages.join(" · ") %></p>

  <ul class="mt-3 space-y-1 text-sm text-slate-700">
    <% match.reasons.each do |reason| %>
      <li class="flex gap-2"><span class="text-sky-600" aria-hidden="true">✓</span><%= reason %></li>
    <% end %>
  </ul>

  <% if match.trip.note.present? %>
    <p class="mt-3 text-sm text-slate-600 italic">“<%= match.trip.note %>”</p>
  <% end %>
  <div class="mt-3"><%= render "contact", trip: match.trip %></div>
  <%= render "unmatches/button", trip: match.trip, class: "mt-2 text-right", align_end: true %>
</article>
