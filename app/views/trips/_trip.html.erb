<article class="flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-4">
  <div class="flex items-start justify-between gap-2">
    <div class="flex min-w-0 gap-3">
      <%= avatar_tag(trip, size: "h-10 w-10") %>
      <div class="min-w-0">
      <h3 class="font-semibold text-slate-900">
        <%= link_to trip.name, trip, class: "hover:underline" %>
        <span class="text-sm font-normal text-slate-500">· <%= trip.skill_level %></span>
        <% if trip.demo? %><span class="ml-1 rounded bg-slate-100 px-1.5 py-0.5 align-middle text-[11px] font-normal text-slate-500">Sample</span><% end %>
      </h3>
      <p class="text-sm text-slate-600"><%= trip.resort %>, <%= trip.region %></p>
      </div>
    </div>
    <span class="shrink-0 rounded-md bg-slate-100 px-2 py-1 text-xs text-slate-700"><%= trip_dates(trip) %></span>
  </div>

  <%= render "tags", label: "Looking for", keys: trip.looking_for, tone: :want %>
  <%= render "tags", label: "Can offer", keys: trip.offering, tone: :offer if trip.offering.any? %>

  <p class="text-xs text-slate-500"><%= trip.languages.join(" · ") %></p>
  <%= render "contact", trip: %>
</article>
