<article class="flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-4">
  <%# Fixed three-line header (name and dates / resort / level), so long levels
      or resort names never push the Sample label onto a line of its own. %>
  <div class="flex gap-3">
    <%= avatar_tag(trip, size: "h-10 w-10") %>
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-2">
        <h3 class="flex min-w-0 items-center gap-1.5 font-semibold text-slate-900">
          <%= link_to trip.name, trip, class: "truncate hover:underline" %>
          <% if trip.demo? %><span class="shrink-0 rounded bg-slate-100 px-1.5 py-0.5 text-[11px] font-normal text-slate-500">Sample</span><% end %>
        </h3>
        <span class="shrink-0 rounded-md bg-slate-100 px-2 py-1 text-xs text-slate-700"><%= trip_dates(trip) %></span>
      </div>
      <p class="truncate text-sm text-slate-600" title="<%= resorts_with_regions(trip) %>"><%= resorts_with_regions(trip) %></p>
      <p class="text-xs text-slate-500"><%= trip.skill_level.capitalize %></p>
    </div>
  </div>

  <%= render "tags", label: "Looking for", keys: trip.looking_for, tone: :want %>
  <%= render "tags", label: "Can offer", keys: trip.offering, tone: :offer if trip.offering.any? %>

  <p class="text-xs text-slate-500"><%= trip.languages.join(" · ") %></p>
  <%= render "contact", trip: %>
</article>
