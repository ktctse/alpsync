<% content_for :title, "Edit your trip · Alpsync" %>

<div class="mx-auto max-w-2xl">
  <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
    <h1 class="text-2xl font-semibold text-slate-900">Edit your trip</h1>
    <%= render "messages_link", trip: @trip, class: "inline-flex items-center gap-1.5 text-sm font-medium text-sky-700 underline" %>
  </div>
  <%= render "form", trip: @trip %>

  <div class="mt-10 rounded-xl border border-red-200 bg-white p-4 sm:p-6">
    <h2 class="font-semibold text-red-800">Delete this trip</h2>
    <p class="mt-1 text-sm text-slate-600">It disappears from the feed and from other riders' matches straight away.</p>
    <%# Confirmed on the page rather than with a browser pop-up, which some
        browsers (including embedded ones) block, silently cancelling the delete. %>
    <details class="group mt-3">
      <summary class="inline-block cursor-pointer list-none rounded-lg border border-red-300 px-4 py-2 text-sm text-red-700 hover:bg-red-50 group-open:hidden">
        Delete trip
      </summary>
      <div class="flex flex-wrap items-center gap-3">
        <p class="text-sm text-slate-700">Delete it for good? This can't be undone.</p>
        <%= button_to "Yes, delete it", manage_trip_path(@trip.edit_token), method: :delete,
                      class: "cursor-pointer rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700" %>
      </div>
    </details>
  </div>
</div>
