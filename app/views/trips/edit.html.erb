<% content_for :title, "Edit your trip · Alpsync" %>

<div class="mx-auto max-w-2xl">
  <h1 class="mb-6 text-2xl font-semibold text-slate-900">Edit your trip</h1>
  <%= render "form", trip: @trip %>

  <div class="mt-10 rounded-xl border border-red-200 bg-white p-4 sm:p-6">
    <h2 class="font-semibold text-red-800">Delete this trip</h2>
    <p class="mt-1 text-sm text-slate-600">It disappears from the feed and from other riders' matches straight away.</p>
    <%= button_to "Delete trip", manage_trip_path(@trip.edit_token), method: :delete,
                  form: { data: { turbo_confirm: "Delete this trip? This can't be undone." } },
                  class: "mt-3 cursor-pointer rounded-lg border border-red-300 px-4 py-2 text-sm text-red-700 hover:bg-red-50" %>
  </div>
</div>
