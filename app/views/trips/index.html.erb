<% content_for :title, "Alpsync · Find your ski and snowboard crew" %>

<% content_for :hero do %>
  <%# Banner: the developer's own mountain photos, graded deep blue, sliding every
      few seconds (slideshow_controller.js), with a film-grain overlay. Tall, with
      the text anchored to the bottom so the peaks rise above the headline; a
      bottom gradient keeps the text readable. %>
  <%# Jade Dragon Snow Mountain (Yunnan), Shiga Kogen (Nagano), Western Sichuan %>
  <% slides = [
       { image: "banner-jade-dragon.jpg", position: "object-[50%_25%]" },
       { image: "banner-shiga-kogen.jpg", position: "object-[50%_40%]" },
       { image: "banner-western-sichuan.jpg", position: "object-[50%_30%]" }
     ] %>
  <section class="relative isolate flex min-h-[20rem] flex-col justify-end overflow-hidden bg-slate-800 sm:min-h-[min(26rem,45vh)]"
           data-controller="slideshow"
           data-action="mouseenter->slideshow#stop mouseleave->slideshow#start focusin->slideshow#stop focusout->slideshow#start">
    <div class="absolute inset-0 -z-10 overflow-hidden">
      <div class="flex h-full transition-transform duration-700 ease-in-out" data-slideshow-target="track">
        <% slides.each_with_index do |slide, i| %>
          <%= image_tag slide[:image], alt: "", fetchpriority: (i.zero? ? "high" : "low"),
                        class: "h-full w-full shrink-0 object-cover #{slide[:position]}" %>
        <% end %>
      </div>
    </div>
    <div class="absolute inset-0 -z-10 bg-linear-to-t from-slate-950/85 via-slate-950/35 to-transparent"></div>
    <div class="absolute inset-0 -z-10 opacity-40 mix-blend-overlay"
         style="background-image: url(<%= asset_path("grain.svg") %>)"></div>

    <div class="mx-auto w-full max-w-5xl px-4 pt-10 pb-6 sm:pt-24 sm:pb-8">
      <h1 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">Find your ski and snowboard crew</h1>
      <p class="mt-3 max-w-2xl text-sm text-slate-200 sm:text-base">
        Post your ski or snowboard trip with what you're looking for and can offer. Alpsync matches you
        with riders on the same dates, whether that's a driver, a lodge mate, or a coach.
      </p>

      <%= form_with url: trips_path, method: :get, class: "mt-6 grid grid-cols-2 gap-2 sm:grid-cols-5",
                    data: { turbo_frame: "trips", turbo_action: "advance" } do |f| %>
        <%= f.select :region, ResortCatalog.regions, { include_blank: "Any region", selected: @filters[:region] }, class: field_class, "aria-label": "Region" %>
        <%= f.select :language, Trip::LANGUAGES, { include_blank: "Any language", selected: @filters[:language] }, class: field_class, "aria-label": "Language" %>
        <%= f.select :tag, TagCatalog::ALL.map { |tag| [ tag.label, tag.key ] }, { include_blank: "Any tag", selected: @filters[:tag] }, class: field_class, "aria-label": "Tag" %>
        <%= f.date_field :on, value: @filters[:on], class: field_class, "aria-label": "On the slopes on" %>
        <%= f.submit "Filter", name: nil, class: "col-span-2 cursor-pointer rounded-lg bg-sky-600 px-3 py-2 text-sm font-medium text-white hover:bg-sky-700 sm:col-span-1" %>
      <% end %>
    </div>
  </section>
<% end %>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_16rem]">
  <%# autoscroll brings the top of the feed into view after paging or filtering %>
  <%= turbo_frame_tag "trips", target: "_top", autoscroll: true, data: { autoscroll_block: "start" } do %>
    <%# The count line is always shown (even "0 upcoming trips") so the sidebar,
        offset by the same height, lines up with the first row of cards. %>
    <p class="mb-3 h-5 text-sm text-slate-500">
      <%= pluralize(@total, "upcoming trip") %><% if @pages > 1 %> · page <%= @page %> of <%= @pages %><% end %>
    </p>
    <% if @trips.any? %>
      <div class="grid gap-4 sm:grid-cols-2">
        <%= render partial: "trip", collection: @trips %>
      </div>

      <% if @pages > 1 %>
        <%# Page numbers load inside the feed and keep the current filters %>
        <nav class="mt-6 flex flex-wrap justify-center gap-1" aria-label="Trip pages">
          <% 1.upto(@pages) do |number| %>
            <%= link_to number, trips_path(@filters.to_h.merge(page: number)),
                        data: { turbo_frame: "trips", turbo_action: "advance" },
                        aria: { current: ("page" if number == @page), label: "Page #{number}" },
                        class: "min-w-9 rounded-md px-2.5 py-1.5 text-center text-sm text-slate-600 tabular-nums hover:bg-white aria-[current=page]:bg-slate-900 aria-[current=page]:text-white" %>
          <% end %>
        </nav>
      <% end %>
    <% else %>
      <div class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-600">
        No trips match those filters yet.
        <%= link_to "Post yours", new_trip_path, class: "font-medium text-sky-700 underline" %> and be the first.
      </div>
    <% end %>
  <% end %>

  <%= render "sidebar", on_the_mountain: @on_the_mountain, just_posted: @just_posted %>
</div>

<% content_for :finale do %>
  <%# Motion graphic: Everest traced in a jagged line around the Alpsync logo
      (everest_controller.js). Move across to circle the mountain, down to look
      at the climbing route from above. %>
  <section class="relative isolate h-[70vh] max-h-[48rem] min-h-[26rem] touch-pan-y overflow-hidden bg-[#05070b]"
           data-controller="everest" data-action="pointermove->everest#point pointerleave->everest#release">
    <canvas class="absolute inset-0 h-full w-full" data-everest-target="canvas" role="img"
            aria-label="Animated line drawing of Mount Everest around the Alpsync logo, changing as it circles the mountain and tilts to show the South Col route from above"></canvas>
    <div class="pointer-events-none absolute inset-0 opacity-25 mix-blend-overlay"
         style="background-image: url(<%= asset_path("grain.svg") %>)"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 mx-auto max-w-5xl px-4 pb-8 font-mono text-[11px] leading-relaxed text-slate-300 sm:text-xs" data-everest-target="caption">
      <p class="max-w-md">
        <span class="underline underline-offset-4">Alp</span> for the mountain,
        <span class="underline underline-offset-4">sync</span> for riding the same days as the right people.
        Almost every summit is a team effort, and so is a great ski or snowboard trip: someone to drive,
        someone to split the lodge with. Alpsync finds your crew.
      </p>
      <p class="mt-4 text-slate-400">Everest, 8,849 m · 27°59′17″N 86°55′31″E</p>
      <p class="mt-1 text-slate-500"><span data-everest-target="view">Seen from the south</span>. Move across to circle the mountain, down to trace the South Col route.</p>
      <p class="mt-3 text-slate-600">
        Motion graphic inspired by
        <a href="https://raideresearch.com" target="_blank" rel="noopener"
           class="pointer-events-auto underline underline-offset-4 hover:text-slate-300">Raide Research</a>.
      </p>
    </div>
  </section>
<% end %>
