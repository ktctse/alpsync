<% content_for :title, "Alpsync · Find your people for the mountain" %>

<% content_for :hero do %>
  <%# Banner: the developer's own mountain photos, graded deep blue, sliding every
      few seconds (slideshow_controller.js), with a film-grain overlay. Tall, with
      the text anchored to the bottom so the peaks rise above the headline; a
      bottom gradient keeps the text readable. %>
  <%# Jade Dragon Snow Mountain (Yunnan), Shiga Kogen (Nagano), Western Sichuan %>
  <% slides = [
       { image: "banner-jade-dragon.jpg", position: "object-[50%_25%]" },
       { image: "banner-shiga-kogen.jpg", position: "object-[50%_40%]" },
       { image: "banner-western-sichuan.jpg", position: "object-[50%_30%]" }
     ] %>
  <section class="relative isolate flex min-h-[32rem] flex-col justify-end overflow-hidden bg-slate-800 sm:min-h-[38rem]"
           data-controller="slideshow"
           data-action="mouseenter->slideshow#stop mouseleave->slideshow#start focusin->slideshow#stop focusout->slideshow#start">
    <div class="absolute inset-0 -z-10 overflow-hidden">
      <div class="flex h-full transition-transform duration-700 ease-in-out" data-slideshow-target="track">
        <% slides.each_with_index do |slide, i| %>
          <%= image_tag slide[:image], alt: "", fetchpriority: (i.zero? ? "high" : "low"),
                        class: "h-full w-full shrink-0 object-cover #{slide[:position]}" %>
        <% end %>
      </div>
    </div>
    <div class="absolute inset-0 -z-10 bg-linear-to-t from-slate-950/85 via-slate-950/35 to-transparent"></div>
    <div class="absolute inset-0 -z-10 opacity-40 mix-blend-overlay"
         style="background-image: url(<%= asset_path("grain.svg") %>)"></div>

    <div class="mx-auto w-full max-w-5xl px-4 pt-40 pb-8 sm:pb-10">
      <h1 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">Find your people for the mountain</h1>
      <p class="mt-3 max-w-2xl text-slate-200">
        Post your trip with what you're looking for and what you can offer. Alpsync matches you with riders
        on the same dates who fit, whether that's a driver, a lodge mate, or a coach.
      </p>

      <%= form_with url: trips_path, method: :get, class: "mt-8 grid grid-cols-2 gap-2 sm:grid-cols-5",
                    data: { turbo_frame: "trips", turbo_action: "advance" } do |f| %>
        <%= f.select :region, ResortCatalog.regions, { include_blank: "Any region", selected: @filters[:region] }, class: field_class, "aria-label": "Region" %>
        <%= f.select :language, Trip::LANGUAGES, { include_blank: "Any language", selected: @filters[:language] }, class: field_class, "aria-label": "Language" %>
        <%= f.select :tag, TagCatalog::ALL.map { |tag| [ tag.label, tag.key ] }, { include_blank: "Any tag", selected: @filters[:tag] }, class: field_class, "aria-label": "Tag" %>
        <%= f.date_field :on, value: @filters[:on], class: field_class, "aria-label": "On the mountain on" %>
        <%= f.submit "Filter", name: nil, class: "col-span-2 cursor-pointer rounded-lg bg-sky-600 px-3 py-2 text-sm font-medium text-white hover:bg-sky-700 sm:col-span-1" %>
      <% end %>
    </div>
  </section>
<% end %>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_16rem]">
  <%= turbo_frame_tag "trips", target: "_top" do %>
    <%# The count line is always shown (even "0 upcoming trips") so the sidebar,
        offset by the same height, lines up with the first row of cards. %>
    <p class="mb-3 h-5 text-sm text-slate-500"><%= pluralize(@trips.size, "upcoming trip") %></p>
    <% if @trips.any? %>
      <div class="grid gap-4 sm:grid-cols-2">
        <%= render partial: "trip", collection: @trips %>
      </div>
    <% else %>
      <div class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-600">
        No trips match those filters yet.
        <%= link_to "Post yours", new_trip_path, class: "font-medium text-sky-700 underline" %> and be the first.
      </div>
    <% end %>
  <% end %>

  <%= render "sidebar", on_the_mountain: @on_the_mountain, just_posted: @just_posted %>
</div>
