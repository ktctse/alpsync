<% content_for :title, "Alpsync · Find your people for the mountain" %>

<section class="mb-6">
  <h1 class="text-2xl font-semibold text-slate-900 sm:text-3xl">Find your people for the mountain</h1>
  <p class="mt-2 max-w-2xl text-slate-600">
    Post your trip with what you're looking for and what you can offer. Alpsync matches you with riders
    on the same dates who fit, whether that's a driver, a lodge mate or a coach.
  </p>
</section>

<%= form_with url: trips_path, method: :get, class: "mb-6 grid grid-cols-2 gap-2 sm:grid-cols-5",
              data: { turbo_frame: "trips", turbo_action: "advance" } do |f| %>
  <%= f.select :region, ResortCatalog.regions, { include_blank: "Any region", selected: @filters[:region] }, class: field_class, "aria-label": "Region" %>
  <%= f.select :language, Trip::LANGUAGES, { include_blank: "Any language", selected: @filters[:language] }, class: field_class, "aria-label": "Language" %>
  <%= f.select :tag, TagCatalog::ALL.map { |tag| [ tag.label, tag.key ] }, { include_blank: "Any tag", selected: @filters[:tag] }, class: field_class, "aria-label": "Tag" %>
  <%= f.date_field :on, value: @filters[:on], class: field_class, "aria-label": "On the mountain on" %>
  <%= f.submit "Filter", name: nil, class: "col-span-2 cursor-pointer rounded-lg bg-sky-600 px-3 py-2 text-sm font-medium text-white hover:bg-sky-700 sm:col-span-1" %>
<% end %>

<%= turbo_frame_tag "trips", target: "_top" do %>
  <% if @trips.any? %>
    <p class="mb-3 text-sm text-slate-500"><%= pluralize(@trips.size, "upcoming trip") %></p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <%= render partial: "trip", collection: @trips %>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-600">
      No trips match those filters yet.
      <%= link_to "Post yours", new_trip_path, class: "font-medium text-sky-700 underline" %> and be the first.
    </div>
  <% end %>
<% end %>
