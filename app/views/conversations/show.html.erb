<% content_for :title, "#{@other.name} · Messages · Alpsync" %>
<%# Live updates: new messages in this conversation arrive over Action Cable %>
<%= turbo_stream_from @conversation %>

<div class="mx-auto max-w-2xl">
  <%= link_to "← All messages", conversations_path, class: "text-sm text-slate-600 hover:underline" %>

  <div class="mt-3 flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4">
    <%= avatar_tag(@other, size: "h-10 w-10") %>
    <div class="min-w-0">
      <p class="font-semibold text-slate-900"><%= link_to @other.name, @other, class: "hover:underline" %></p>
      <p class="truncate text-sm text-slate-500"><%= resort_list(@other) %> · <%= trip_dates(@other) %></p>
    </div>
  </div>

  <div id="messages" class="mt-4 flex min-h-24 flex-col gap-2" data-controller="chat" data-chat-me-value="<%= my_trip.id %>">
    <%= render @messages %>
  </div>
  <%# Hidden by chat_controller.js once there are messages %>
  <p id="chat_hint" class="text-sm text-slate-500" <%= "hidden" if @messages.any? %>>Say hi and mention which of their needs you can cover.</p>

  <%= render "messages/form", conversation: @conversation, message: Message.new %>
  <p id="message_error" class="mt-1 text-sm text-red-700" aria-live="polite"></p>

  <p class="mt-4 text-xs text-slate-500">
    Messages are kept on Alpsync so you both can see them, and are deleted when either trip is deleted.
    Share phone numbers or handles only when you're comfortable.
  </p>

  <%= render "unmatches/button", trip: @other, class: "mt-3" %>

  <details class="mt-3">
    <summary class="cursor-pointer text-xs text-slate-500 hover:text-slate-700">Report this conversation</summary>
    <div class="mt-2 flex flex-wrap items-center gap-3">
      <p class="text-sm text-slate-700">Flag it for review if it's spam or makes you uncomfortable.</p>
      <%= button_to "Report it", report_conversation_path(@conversation), method: :patch,
                    class: "cursor-pointer rounded-lg border border-red-300 px-3 py-1.5 text-sm text-red-700 hover:bg-red-50" %>
    </div>
  </details>
</div>
