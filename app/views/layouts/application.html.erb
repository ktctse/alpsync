<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Alpsync" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Alpsync">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# Served from the asset pipeline so the URL changes whenever the logo does %>
    <link rel="icon" href="<%= asset_path("logo.png") %>" type="image/png">
    <link rel="icon" href="<%= asset_path("logo.svg") %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= asset_path("logo.png") %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full bg-slate-50 text-slate-800 antialiased">
    <%# relative z-40 keeps the header's pop-up hint above the banner photo %>
    <header class="relative z-40 border-b border-slate-200 bg-white">
      <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4">
        <%= link_to root_path, class: "flex shrink-0 items-center gap-1.5 text-base font-semibold tracking-tight text-slate-900 sm:gap-2 sm:text-lg" do %>
          <%= image_tag "logo.svg", alt: "", class: "h-6 w-6" %>
          <span>alp<span class="text-sky-600">sync</span></span>
        <% end %>
        <nav class="flex items-center gap-1 text-[13px] whitespace-nowrap sm:gap-2 sm:text-sm">
          <% if my_trip %>
            <%= link_to trip_path(my_trip), class: "rounded-lg px-2 py-1.5 text-slate-700 hover:bg-slate-100 sm:px-3" do %>
              <span class="hidden sm:inline">Your </span>matches
            <% end %>
            <%= link_to conversations_path, class: "relative rounded-lg px-2 py-1.5 text-slate-700 hover:bg-slate-100 sm:px-3" do %>
              Messages
              <% if unread_messages? %>
                <span class="absolute top-1 right-1 h-2 w-2 rounded-full bg-sky-600" role="img" aria-label="Unread messages"></span>
              <% end %>
            <% end %>
          <% else %>
            <%# Visitors see what posting unlocks: greyed-out links, explained on
                hover, tap or keyboard focus (hint_controller.js) %>
            <div class="group relative flex items-center" data-controller="hint"
                 data-action="click@window->hint#closeOutside keydown.esc@window->hint#close">
              <span class="cursor-not-allowed rounded-lg px-1 py-1.5 text-slate-400 sm:px-3"><span class="hidden sm:inline">Your </span>matches</span>
              <span class="cursor-not-allowed rounded-lg px-1 py-1.5 text-slate-400 sm:px-3">Messages</span>
              <button type="button" aria-label="Why are these locked?" aria-describedby="locked_hint" aria-expanded="false"
                      class="ml-0.5 flex h-5 w-5 shrink-0 cursor-pointer items-center justify-center rounded-full border border-slate-300 font-serif text-xs text-slate-500 italic hover:border-slate-400 hover:text-slate-700 focus-visible:ring-2 focus-visible:ring-sky-300 focus-visible:outline-none"
                      data-hint-target="button" data-action="hint#toggle">i</button>
              <div id="locked_hint" role="tooltip"
                   class="invisible absolute top-full right-0 z-30 mt-2 w-64 rounded-lg bg-slate-900 p-3 text-xs leading-relaxed whitespace-normal text-white opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 group-data-[open]:visible group-data-[open]:opacity-100">
                Post a trip to unlock your matches and messages. It's free, there's no account to make, and it takes about a minute.
              </div>
            </div>
          <% end %>
          <%= link_to "Post a trip", new_trip_path, class: "rounded-lg bg-slate-900 px-2 py-1.5 text-white hover:bg-slate-700 sm:px-3" %>
        </nav>
      </div>
    </header>

    <%# Full-width banner, set by pages that have one (the trip feed) %>
    <%= yield :hero %>

    <main class="mx-auto max-w-5xl px-4 py-6">
      <% flash.each do |_type, message| %>
        <p class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm text-emerald-800"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>

    <footer class="mx-auto max-w-5xl px-4 pb-10 text-xs text-slate-500">
      Alpsync is a demo project. The trips shown are fictional sample data.
    </footer>

    <%# Full-width closing section, set by pages that have one (the trip feed) %>
    <%= yield :finale %>
  </body>
</html>
