#!/bin/bash -e

# If running the rails server then create or migrate existing database, and top
# up the fictional demo trips if most have ended (db/seeds.rb is safe to repeat)
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare db:seed
fi

exec "${@}"
